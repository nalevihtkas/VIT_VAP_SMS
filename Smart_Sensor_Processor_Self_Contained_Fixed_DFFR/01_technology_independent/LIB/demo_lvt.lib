library (demo_lvt_lib) {
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1,pf);
  nominal_voltage : 1.0;
  nominal_temperature : 25;
  nominal_process : 1.0;
  default_operating_conditions : typical;

  operating_conditions (typical) {
    process : 1.0;
    voltage : 1.0;
    temperature : 25;
    tree_type : balanced_tree;
  }

  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.10");
    index_2 ("0.01, 0.10");
  }

  lu_table_template (constraint_template) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.01, 0.10");
    index_2 ("0.01, 0.10");
  }

  cell (INV_X1_LVT) {
    area : 1.0;
    cell_leakage_power : 0.020000;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!A";
      max_capacitance : 0.20;
      timing() {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise(delay_template) { values("0.03,0.05","0.05,0.08"); }
        cell_fall(delay_template) { values("0.03,0.05","0.05,0.08"); }
        rise_transition(delay_template) { values("0.02,0.04","0.04,0.07"); }
        fall_transition(delay_template) { values("0.02,0.04","0.04,0.07"); }
      }
    }
  }

  cell (BUF_X1_LVT) {
    area : 1.0;
    cell_leakage_power : 0.020000;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.12;
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(delay_template) { values("0.03,0.05","0.05,0.08"); }
        cell_fall(delay_template) { values("0.03,0.05","0.05,0.08"); }
        rise_transition(delay_template) { values("0.02,0.04","0.04,0.07"); }
        fall_transition(delay_template) { values("0.02,0.04","0.04,0.07"); }
      }
    }
  }

  cell (BUF_X4_LVT) {
    area : 2.8;
    cell_leakage_power : 0.060000;
    pin (A) { direction : input; capacitance : 0.004; }
    pin (Y) {
      direction : output;
      function : "A";
      max_capacitance : 0.50;
      timing() {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise(delay_template) { values("0.02,0.03","0.03,0.05"); }
        cell_fall(delay_template) { values("0.02,0.03","0.03,0.05"); }
        rise_transition(delay_template) { values("0.01,0.02","0.02,0.04"); }
        fall_transition(delay_template) { values("0.01,0.02","0.02,0.04"); }
      }
    }
  }

  cell (AND2_X1_LVT) {
    area : 1.2;
    cell_leakage_power : 0.030000;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "A & B";
      max_capacitance : 0.12;
      timing() { related_pin : "A"; timing_sense : positive_unate;
        cell_rise(delay_template){values("0.05,0.07","0.08,0.12");}
        cell_fall(delay_template){values("0.05,0.07","0.08,0.12");}
        rise_transition(delay_template){values("0.03,0.05","0.05,0.09");}
        fall_transition(delay_template){values("0.03,0.05","0.05,0.09");}
      }
      timing() { related_pin : "B"; timing_sense : positive_unate;
        cell_rise(delay_template){values("0.05,0.07","0.08,0.12");}
        cell_fall(delay_template){values("0.05,0.07","0.08,0.12");}
        rise_transition(delay_template){values("0.03,0.05","0.05,0.09");}
        fall_transition(delay_template){values("0.03,0.05","0.05,0.09");}
      }
    }
  }

  cell (AND2_X4_LVT) {
    area : 2.5;
    cell_leakage_power : 0.080000;
    pin (A) { direction : input; capacitance : 0.004; }
    pin (B) { direction : input; capacitance : 0.004; }
    pin (Y) {
      direction : output;
      function : "A & B";
      max_capacitance : 0.50;
      timing() { related_pin : "A"; timing_sense : positive_unate;
        cell_rise(delay_template){values("0.025,0.04","0.04,0.06");}
        cell_fall(delay_template){values("0.025,0.04","0.04,0.06");}
        rise_transition(delay_template){values("0.015,0.025","0.025,0.04");}
        fall_transition(delay_template){values("0.015,0.025","0.025,0.04");}
      }
      timing() { related_pin : "B"; timing_sense : positive_unate;
        cell_rise(delay_template){values("0.025,0.04","0.04,0.06");}
        cell_fall(delay_template){values("0.025,0.04","0.04,0.06");}
        rise_transition(delay_template){values("0.015,0.025","0.025,0.04");}
        fall_transition(delay_template){values("0.015,0.025","0.025,0.04");}
      }
    }
  }

  cell (OR2_X1_LVT) {
    area : 1.2;
    cell_leakage_power : 0.030000;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "A | B";
      max_capacitance : 0.12;
      timing() { related_pin : "A"; timing_sense : positive_unate;
        cell_rise(delay_template){values("0.05,0.07","0.08,0.12");}
        cell_fall(delay_template){values("0.05,0.07","0.08,0.12");}
        rise_transition(delay_template){values("0.03,0.05","0.05,0.09");}
        fall_transition(delay_template){values("0.03,0.05","0.05,0.09");}
      }
      timing() { related_pin : "B"; timing_sense : positive_unate;
        cell_rise(delay_template){values("0.05,0.07","0.08,0.12");}
        cell_fall(delay_template){values("0.05,0.07","0.08,0.12");}
        rise_transition(delay_template){values("0.03,0.05","0.05,0.09");}
        fall_transition(delay_template){values("0.03,0.05","0.05,0.09");}
      }
    }
  }

  cell (NAND2_X1_LVT) {
    area : 1.0;
    cell_leakage_power : 0.024000;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "!(A & B)"; max_capacitance : 0.12; }
  }

  cell (NOR2_X1_LVT) {
    area : 1.0;
    cell_leakage_power : 0.024000;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (B) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "!(A | B)"; max_capacitance : 0.12; }
  }

  cell (XOR2_X1_LVT) {
    area : 1.8;
    cell_leakage_power : 0.040000;
    pin (A) { direction : input; capacitance : 0.003; }
    pin (B) { direction : input; capacitance : 0.003; }
    pin (Y) { direction : output; function : "A ^ B"; max_capacitance : 0.12; }
  }

  cell (MUX2_X1_LVT) {
    area : 2.0;
    cell_leakage_power : 0.040000;
    pin (A) { direction : input; capacitance : 0.003; }
    pin (B) { direction : input; capacitance : 0.003; }
    pin (S) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "(A & !S) | (B & S)"; max_capacitance : 0.12; }
  }

  cell (AOI22_X1_LVT) {
    area : 1.8;
    cell_leakage_power : 0.040000;
    pin (A1) { direction : input; capacitance : 0.002; }
    pin (A2) { direction : input; capacitance : 0.002; }
    pin (B1) { direction : input; capacitance : 0.002; }
    pin (B2) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "!((A1 & A2) | (B1 & B2))"; max_capacitance : 0.12; }
  }

  cell (OAI22_X1_LVT) {
    area : 1.8;
    cell_leakage_power : 0.040000;
    pin (A1) { direction : input; capacitance : 0.002; }
    pin (A2) { direction : input; capacitance : 0.002; }
    pin (B1) { direction : input; capacitance : 0.002; }
    pin (B2) { direction : input; capacitance : 0.002; }
    pin (Y) { direction : output; function : "!((A1 | A2) & (B1 | B2))"; max_capacitance : 0.12; }
  }

  cell (DFF_X1_LVT) {
    area : 4.0;
    cell_leakage_power : 0.100000;
    ff (IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
    }
    pin (CLK) {
      direction : input;
      clock : true;
      capacitance : 0.004;
    }
    pin (D) {
      direction : input;
      capacitance : 0.003;
      timing() {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint(constraint_template){values("0.05,0.05","0.05,0.05");}
        fall_constraint(constraint_template){values("0.05,0.05","0.05,0.05");}
      }
      timing() {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint(constraint_template){values("0.01,0.01","0.01,0.01");}
        fall_constraint(constraint_template){values("0.01,0.01","0.01,0.01");}
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      max_capacitance : 0.12;
      timing() {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise(delay_template){values("0.08,0.10","0.10,0.14");}
        cell_fall(delay_template){values("0.08,0.10","0.10,0.14");}
        rise_transition(delay_template){values("0.03,0.05","0.05,0.08");}
        fall_transition(delay_template){values("0.03,0.05","0.05,0.08");}
      }
    }
  }

  /* Active-low asynchronous-clear D flip-flop.
   * Required by RTL coded as: always @(posedge clk or negedge rst_n)
   */
  cell (DFFR_X1_LVT) {
    area : 4.5;
    cell_leakage_power : 0.060;

    ff (IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
      clear      : "!RN";
    }

    pin (CLK) {
      direction : input;
      clock : true;
      capacitance : 0.004;
    }

    pin (RN) {
      direction : input;
      capacitance : 0.003;
      timing() {
        related_pin : "CLK";
        timing_type : recovery_rising;
        rise_constraint(constraint_template){values("0.05,0.05","0.05,0.05");}
        fall_constraint(constraint_template){values("0.05,0.05","0.05,0.05");}
      }
      timing() {
        related_pin : "CLK";
        timing_type : removal_rising;
        rise_constraint(constraint_template){values("0.01,0.01","0.01,0.01");}
        fall_constraint(constraint_template){values("0.01,0.01","0.01,0.01");}
      }
    }

    pin (D) {
      direction : input;
      capacitance : 0.003;
      timing() {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint(constraint_template){values("0.05,0.05","0.05,0.05");}
        fall_constraint(constraint_template){values("0.05,0.05","0.05,0.05");}
      }
      timing() {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint(constraint_template){values("0.01,0.01","0.01,0.01");}
        fall_constraint(constraint_template){values("0.01,0.01","0.01,0.01");}
      }
    }

    pin (Q) {
      direction : output;
      function : "IQ";
      max_capacitance : 0.12;
      timing() {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise(delay_template){values("0.08,0.10","0.10,0.14");}
        cell_fall(delay_template){values("0.08,0.10","0.10,0.14");}
        rise_transition(delay_template){values("0.03,0.05","0.05,0.08");}
        fall_transition(delay_template){values("0.03,0.05","0.05,0.08");}
      }
    }
  }
}
